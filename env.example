# Crown Room Engine environment
# COPY THIS FILE TO .env AND FILL IN REAL VALUES. NEVER COMMIT .env TO GIT.
#   cp env.example .env
#
# Generate the three secrets with:  openssl rand -hex 32   (run it three times)

SERVER_PORT=3001
STORAGE_DIR=/app/server/storage

# --- security (required, generate fresh values) ---
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
SIG_KEY=REPLACE_WITH_openssl_rand_hex_32
SIG_SALT=REPLACE_WITH_openssl_rand_hex_32

# --- default LLM provider for all rooms (per-room overrides set by setup-rooms.sh) ---
# IMPORTANT: use a NEW OpenRouter key. The old one from the desktop app is exposed
# in plaintext on the laptop and must be treated as burned. Rotate it at
# openrouter.ai, fund it with prepaid credits, and paste the new key here.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_MODEL_PREF=meta-llama/llama-3.3-70b-instruct
OPENROUTER_TIMEOUT_MS=60000

# --- embeddings + vectors (local, private, no external calls) ---
EMBEDDING_ENGINE=native
VECTOR_DB=lancedb

# --- privacy hardening ---
DISABLE_TELEMETRY=true
